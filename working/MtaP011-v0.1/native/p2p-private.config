# Private project build only. Never install over /usr/sbin/wpa_supplicant.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_INTERNAL_LIBTOMMATH_FAST=y
CONFIG_WPS=y
CONFIG_P2P=y
CONFIG_AP=y
CONFIG_NO_CONFIG_WRITE=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211W=y
CONFIG_NO_ROAMING=y
# No EAP, system D-Bus owner, debug key output, persistent config, or GUI.
