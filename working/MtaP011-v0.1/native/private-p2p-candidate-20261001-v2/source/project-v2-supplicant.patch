+/* Project diagnostics: fixed numeric stages, no format/string/key inputs.
+ * FD 3 is a private inherited pipe, never a log or public control socket. */
+void mta_p2p_diag(unsigned int stage, int code)
+{
+	const char *enabled = getenv("MTA_PRIVATE_P2P");
+	char line[64];
+	int length;
+
+	if (!enabled || strcmp(enabled, "1") != 0 || stage > 32)
+		return;
+	if (code < -4095 || code > 4095)
+		code = -4095;
+	length = snprintf(line, sizeof(line),
+			  "MTA_P2P_DIAG stage=%u code=%d\n", stage, code);
+	if (length > 0 && (size_t) length < sizeof(line)) {
+		ssize_t result = write(3, line, length);
+		if (result < 0)
+			return;
+	}
+}
 
 
