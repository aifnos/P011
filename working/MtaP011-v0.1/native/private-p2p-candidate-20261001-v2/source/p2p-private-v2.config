# Private project V2 build only; never install over the original WPA daemon.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_INTERNAL_LIBTOMMATH_FAST=y
CONFIG_WPS=y
CONFIG_P2P=y
CONFIG_AP=y
CONFIG_NO_CONFIG_WRITE=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211W=y
CONFIG_NO_ROAMING=y
CONFIG_NO_STDOUT_DEBUG=y
# Private FD3 numeric diagnostics only. No raw WPA debug or hexdumps.
