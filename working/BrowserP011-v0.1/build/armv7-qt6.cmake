set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_C_COMPILER /usr/bin/arm-linux-gnueabihf-gcc-11)
set(CMAKE_CXX_COMPILER /usr/bin/arm-linux-gnueabihf-g++-11)
set(CMAKE_AR /usr/bin/arm-linux-gnueabihf-ar)
set(CMAKE_RANLIB /usr/bin/arm-linux-gnueabihf-ranlib)
set(CMAKE_STRIP /usr/bin/arm-linux-gnueabihf-strip)

set(P011_WORK /browser-work CACHE PATH "Independent browser build root")
set(P011_SYSROOT /opt/p011/sdk/arm-buildroot-linux-gnueabihf/sysroot CACHE PATH "Read-only old ABI sysroot")
set(P011_DEPS "${P011_WORK}/prefix" CACHE PATH "Independently prepared target dependency prefix")
set(P011_CXX "${P011_WORK}/cxx-runtime-threaded" CACHE PATH "Rebuilt GCC 11 C++ library with verified POSIX threads")
set(CMAKE_SYSROOT "${P011_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${P011_WORK}/target-qt" "${P011_DEPS}" "${P011_CXX}" "${P011_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(P011_CPU_FLAGS "-march=armv7-a -mfpu=neon -mfloat-abi=hard")
set(P011_OLD_START "-B${P011_SYSROOT}/usr/lib/ -B${P011_SYSROOT}/lib/")
set(P011_C_HEADERS "-nostdinc -isystem /usr/lib/gcc-cross/arm-linux-gnueabihf/11/include -isystem ${P011_SYSROOT}/usr/include")
set(CMAKE_C_FLAGS_INIT "${P011_CPU_FLAGS} ${P011_OLD_START} ${P011_C_HEADERS} -I${P011_DEPS}/include")
set(CMAKE_CXX_FLAGS_INIT "${P011_CPU_FLAGS} ${P011_OLD_START} -nostdinc++ -isystem ${P011_CXX}/include/c++/11.4.0 -isystem ${P011_CXX}/include/c++/11.4.0/arm-linux-gnueabihf -isystem ${P011_CXX}/include/c++/11.4.0/backward ${P011_C_HEADERS} -I${P011_DEPS}/include")
set(P011_LINK_FLAGS "-L${P011_CXX}/lib -L${P011_DEPS}/lib -L${P011_SYSROOT}/lib -L${P011_SYSROOT}/usr/lib -Wl,-rpath-link,${P011_CXX}/lib:${P011_DEPS}/lib:${P011_SYSROOT}/lib:${P011_SYSROOT}/usr/lib")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${P011_LINK_FLAGS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${P011_LINK_FLAGS}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${P011_LINK_FLAGS}")
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_LIBDIR} "${P011_DEPS}/lib/pkgconfig:${P011_DEPS}/share/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "")
